{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LokiBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::<LOKI_S3_BUCKET>"
    },
    {
      "Sid": "LokiObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::<LOKI_S3_BUCKET>/*"
    }
  ]
}
